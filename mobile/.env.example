# Modelo para um ambiente só seu. Copie para .env.local quando precisar de um
# endereço diferente do padrão (celular físico, emulador Android, outra porta):
# o .env.local vence os arquivos versionados e não entra no git.
#
# O time já tem dois ambientes prontos, e nenhum deles exige editar código:
#   npm start             -> .env.development (backend local, porta 3000)
#   npm run start:railway -> .env.production  (backend publicado no Railway)
#
# Tudo que começa com EXPO_PUBLIC_ fica dentro do app: nunca coloque segredo aqui.
# Depois de mudar qualquer variável, reinicie o Expo.

# Endereços do backend local (backend/, porta 3000):
#   navegador e simulador iOS -> http://localhost:3000
#   emulador Android          -> http://10.0.2.2:3000
#   celular na mesma rede     -> http://<IP do computador>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Limite de espera das requisições, em milissegundos (padrão 15000).
EXPO_PUBLIC_API_TIMEOUT=15000
