# Copie este arquivo para .env.local (ignorado pelo git) e ajuste a URL.
# Tudo que começa com EXPO_PUBLIC_ fica dentro do app: nunca coloque segredo aqui.
# Depois de mudar a URL, reinicie o Expo limpando o cache: npx expo start -c

# Mock local (npm run mock-api) ou backend Java rodando nesta máquina, na porta 8080:
#   navegador e simulador iOS -> http://localhost:8080
#   emulador Android          -> http://10.0.2.2:8080
#   celular na mesma rede     -> http://<IP do computador>:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# Backend publicado:
# EXPO_PUBLIC_API_URL=https://backend-production-ddd2.up.railway.app
