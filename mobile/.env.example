# Copie para .env e ajuste. Tudo com EXPO_PUBLIC_ vai para dentro do bundle
# e é legível por quem tiver o APK: nunca coloque segredo aqui.

EXPO_PUBLIC_API_URL=https://backend-production-ddd2.up.railway.app

# Local: 10.0.2.2 no emulador Android, localhost no iOS, seu IP em aparelho físico.
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

EXPO_PUBLIC_OPENLIBRARY_URL=https://openlibrary.org
EXPO_PUBLIC_API_TIMEOUT=15000