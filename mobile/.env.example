# Guia das variáveis de ambiente do app (veja "Ambientes da API" no README).
# Tudo que começa com EXPO_PUBLIC_ fica dentro do app: nunca coloque segredo aqui.
#
# Os ambientes já vêm versionados:
#   .env.development -> mock local (npm start)
#   .env.production  -> backend do Railway (npm run start:railway e builds)
#
# Precisa de uma URL só sua? Copie este arquivo para .env.development.local
# (ignorado pelo git) e ajuste. Não use .env.local: ele também entra nos builds.
#   navegador e simulador iOS -> http://localhost:8080
#   emulador Android          -> http://10.0.2.2:8080
#   celular na mesma rede     -> http://<IP do computador>:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
