# Copie este arquivo para .env.local ou .env e ajuste conforme o ambiente.
# Tudo que começa com EXPO_PUBLIC_ fica dentro do bundle do app:
# nunca coloque segredos aqui.
# Depois de mudar a URL, reinicie o Expo limpando o cache:
# npx expo start -c

# Backend local / mock
# Navegador e simulador iOS:
# EXPO_PUBLIC_API_URL=http://localhost:8080

# Emulador Android:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Celular físico na mesma rede:
# EXPO_PUBLIC_API_URL=http://<IP_DO_COMPUTADOR>:8080

# Backend publicado
EXPO_PUBLIC_API_URL=https://backend-production-ddd2.up.railway.app

# OpenLibrary
EXPO_PUBLIC_OPENLIBRARY_URL=https://openlibrary.org

# Timeout das requisições
EXPO_PUBLIC_API_TIMEOUT=15000
