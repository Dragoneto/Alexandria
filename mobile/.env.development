# Ambiente de desenvolvimento, usado pelo npm start.
# Aponta para o mock local da API (npm run mock-api, porta 8080).
# Tudo que começa com EXPO_PUBLIC_ fica dentro do app: nunca coloque segredo aqui.
# Precisa de uma URL só sua (ex.: testar no celular)? Use .env.development.local (veja .env.example).
EXPO_PUBLIC_API_URL=http://localhost:8080
