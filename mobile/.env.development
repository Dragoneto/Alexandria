# Ambiente de desenvolvimento: é o que o npm start usa.
# Tudo que começa com EXPO_PUBLIC_ fica dentro do app: nunca coloque segredo aqui.
#
# Backend desta pasta (backend/), na porta 3000:
#   navegador e simulador iOS -> http://localhost:3000
#   emulador Android          -> http://10.0.2.2:3000
#   celular na mesma rede     -> http://<IP do computador>:3000
#
# Precisa de um endereço só seu? Copie .env.example para .env.local e ajuste a
# URL: o .env.local vence este arquivo e não é versionado.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Limite de espera das requisições, em milissegundos.
EXPO_PUBLIC_API_TIMEOUT=15000
