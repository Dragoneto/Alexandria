# Ambiente publicado: usado pelo npm run start:prod e pelos builds.
# Backend publicado no Render, sem /api no final. Ao trocar o endereço, faça commit:
# toda a equipe passa a usar o mesmo endereço.
# Tudo que começa com EXPO_PUBLIC_ fica dentro do app: nunca coloque segredo aqui.
EXPO_PUBLIC_API_URL=https://alexandria-api-ybps.onrender.com

# Limite de espera das requisições, em milissegundos.
# 60 s porque o plano grátis do Render dorme após 15 min parado e leva cerca de 1 min para acordar.
EXPO_PUBLIC_API_TIMEOUT=60000
