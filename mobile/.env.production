# Ambiente publicado: usado pelo npm run start:railway e pelos builds.
# Cole o link do backend no Railway abaixo, sem /api no final, e faça commit:
# toda a equipe passa a usar o mesmo endereço.
# Tudo que começa com EXPO_PUBLIC_ fica dentro do app: nunca coloque segredo aqui.
EXPO_PUBLIC_API_URL=

# Limite de espera das requisições, em milissegundos.
EXPO_PUBLIC_API_TIMEOUT=15000
