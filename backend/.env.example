# Desenvolvimento local sem PostgreSQL (salva em backend/.data/users.json)
DB_MODE=local

# Produção com Railway PostgreSQL: prefira DATABASE_URL
# DATABASE_URL=postgresql://usuario:senha@host:porta/banco
# DB_SSL=true

# PostgreSQL configurado por campos individuais
DB_HOST=localhost
DB_PORT=5432
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=alexandria

# JWT
JWT_SECRET=trocar_por_uma_chave_secreta_segura

# Servidor
PORT=3000

# Opcional: origens web separadas por vírgula. Vazio permite todas as origens.
CORS_ORIGINS=
