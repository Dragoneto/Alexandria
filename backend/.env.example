# Desenvolvimento local sem PostgreSQL (salva em backend/.data/users.json)
DB_MODE=local

# Produção com Railway PostgreSQL: prefira DATABASE_URL
# DATABASE_URL=postgresql://usuario:senha@host:porta/banco
# DB_SSL=true
# NODE_ENV=production

# PostgreSQL configurado por campos individuais
DB_HOST=localhost
DB_PORT=5432
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=alexandria

# JWT
JWT_SECRET=trocar_por_uma_chave_secreta_segura

# Servidor
PORT=3000

# Opcional: origens web separadas por vírgula. Vazio permite todas as origens.
CORS_ORIGINS=

# Redefinição de senha: minutos de validade do código de 6 dígitos
RESET_TOKEN_TTL_MINUTES=15

# E-mail que manda o código de redefinição de senha. Sem Brevo nem SMTP, a redefinição fica indisponível.
# Opção 1 (produção, Render): Brevo, por API HTTPS. O Render grátis bloqueia SMTP.
# Crie a chave em brevo.com (SMTP & API > API Keys) e valide o remetente de MAIL_FROM em Senders.
BREVO_API_KEY=
# Remetente, no formato: Alexandria <seuemail@exemplo.com>
MAIL_FROM=

# Opção 2 (local): Gmail por SMTP. Só é usada quando BREVO_API_KEY está vazia.
# SMTP_PASS é uma senha de app, não a senha da conta: ative a verificação em duas etapas
# e gere a senha em myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Só no desenvolvimento, para testar sem e-mail: true mostra o código no log e na resposta da API.
# Nunca ligue no Railway: qualquer pessoa conseguiria trocar a senha de qualquer conta.
RESET_CODE_DEBUG=false

# Tradução opcional de sinopses e categorias para português brasileiro.
# Crie uma chave DeepL API e mantenha-a somente no backend/Railway, nunca no app mobile.
# Sem a chave, categorias conhecidas usam traduções locais e os demais textos ficam no original.
DEEPL_AUTH_KEY=
# Opcional: use https://api-free.deepl.com para chaves Free ou https://api.deepl.com para Pro.
# DEEPL_API_URL=
